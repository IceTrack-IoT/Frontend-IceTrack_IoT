    "page": { "type": "integer", "format": "int32", "description": "Zero-based index of this page" },
    "size": { "type": "integer", "format": "int32", "description": "Maximum number of requests a page may hold" },
    "total_elements": { "type": "integer", "format": "int64", "description": "Total number of requests matching the filters" },
    "total_pages": { "type": "integer", "format": "int32", "description": "Number of pages the matching requests span" }
  },
