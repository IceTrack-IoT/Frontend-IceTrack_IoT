{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagedServiceRequestSummaryResource",
  "type": "object",
  "properties": {
    "content": {
      "type": "array",
      "items": { "$ref": "ServiceRequestSummaryResource.schema.json" },
      "description": "Service requests of this page, newest first"
