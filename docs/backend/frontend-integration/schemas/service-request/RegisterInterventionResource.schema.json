{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegisterInterventionResource",
  "type": "object",
  "properties": {
    "service_request_id": {
      "type": "integer",
      "format": "int64",
      "exclusiveMinimum": 0,
      "description": "Identifier of the service request the intervention completes"
    },
    "client_generated_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID generated by the technician's device, kept across retries"
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "What the technician found"
    },
    "actions_taken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "description": "What the technician did"
    },
    "spare_parts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "maxItems": 50
    },
    "photo_evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "maxItems": 20
    },
    "completed_at": {
      "type": "string",
      "description": "Format: date-time (UTC instant, e.g. 2026-11-07T13:05:00Z) When the work finished according to the technician's device, ISO-8601; the server clock is used when absent"
    }
  },
  "required": [
    "service_request_id",
    "client_generated_id",
    "diagnosis",
    "actions_taken"
  ],
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/service/request/interfaces/rest/resources/RegisterInterventionResource.java"
}
