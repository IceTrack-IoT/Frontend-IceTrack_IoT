{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServiceRequestSummaryResource",
  "type": "object",
  "properties": {
    "id": { "type": "integer", "format": "int64", "description": "Service request unique identifier" },
    "equipment_id": { "type": "integer", "format": "int64", "description": "Unit to service" },
    "site_id": { "type": "integer", "format": "int64", "description": "Site the unit is installed at" },
    "technician_id": { "type": ["integer", "null"], "format": "int64", "description": "Assigned technician; null while none is assigned" },
    "type": { "type": "string", "enum": ["PREVENTIVE_MAINTENANCE", "REPAIR"], "description": "Kind of work" },
    "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "URGENT"], "description": "Urgency" },
    "status": { "type": "string", "enum": ["PENDING", "ACCEPTED", "IN_PROGRESS", "COMPLETED", "CANCELED"], "description": "Current lifecycle status" },
    "created_at": { "type": "string", "description": "When the request was created, ISO-8601 UTC" },
    "assigned_at": { "type": ["string", "null"], "description": "When the current technician was assigned" },
    "started_at": { "type": ["string", "null"], "description": "When the work started" },
    "completed_at": { "type": ["string", "null"], "description": "When the work finished" },
    "canceled_at": { "type": ["string", "null"], "description": "When the owner canceled" },
    "equipment_name": { "type": ["string", "null"], "description": "Name of the unit; null when the unit is no longer known" },
    "site_name": { "type": ["string", "null"], "description": "Name of the site; null when the site is no longer known" },
    "technician_name": { "type": ["string", "null"], "description": "Full name of the assigned technician; null while none is assigned" },
    "has_intervention": { "type": "boolean", "description": "Whether an intervention was registered" },
    "has_review": { "type": "boolean", "description": "Whether the owner reviewed the request" },
    "source_alert_id": { "type": ["integer", "null"], "format": "int64", "description": "The alert the request was opened for; null when none" }
  },
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/service/request/interfaces/rest/resources/ServiceRequestSummaryResource.java"
}
