{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InterventionResource",
  "type": "object",
  "properties": {
    "service_request_id": {
      "type": "integer",
      "format": "int64",
      "description": "Identifier of the service request the intervention completed"
    },
    "client_generated_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUID generated by the technician's device"
    },
    "technician_id": {
      "type": "integer",
      "format": "int64",
      "description": "Technician who performed the work"
    },
    "equipment_id": {
      "type": "integer",
      "format": "int64",
      "description": "Unit the work was performed on"
    },
    "diagnosis": {
      "type": "string",
      "description": "What the technician found"
    },
    "actions_taken": {
      "type": "string",
      "description": "What the technician did"
    },
    "spare_parts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Spare parts used"
    },
    "photo_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "References of the photos taken"
    },
    "started_at": {
      "type": "string",
      "description": "When the work started, ISO-8601 UTC"
    },
    "completed_at": {
      "type": "string",
      "description": "When the work finished, ISO-8601 UTC"
    },
    "duration_seconds": {
      "type": "integer",
      "format": "int64",
      "description": "How long the work took, in seconds"
    }
  },
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/service/request/interfaces/rest/resources/InterventionResource.java"
}
