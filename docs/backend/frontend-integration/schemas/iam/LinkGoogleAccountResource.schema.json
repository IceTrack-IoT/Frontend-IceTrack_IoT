{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LinkGoogleAccountResource",
  "type": "object",
  "properties": {
    "id_token": {
      "type": "string",
      "minLength": 1,
      "description": "Google OIDC id_token issued to the frontend"
    },
    "password": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "description": "Current local password of the account whose profile uses the Google email"
    },
    "channel": {
      "type": "string",
      "enum": [
        "WEB",
        "MOBILE"
      ],
      "description": "Client application: WEB for owners, MOBILE for technicians"
    }
  },
  "required": [
    "id_token",
    "password",
    "channel"
  ],
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/iam/interfaces/rest/resources/LinkGoogleAccountResource.java"
}
