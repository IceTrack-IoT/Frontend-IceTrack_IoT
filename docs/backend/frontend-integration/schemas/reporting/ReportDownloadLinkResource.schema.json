{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportDownloadLinkResource",
  "type": "object",
  "properties": {
    "download_url": {
      "type": "string",
      "description": "Signed download URL; the browser saves the file under file_name"
    },
    "expires_at": {
      "type": "string",
      "description": "Format: date-time (ISO 8601 UTC with Z, e.g. 2026-09-29T08:30:00Z) When the signature expires"
    },
    "file_name": {
      "type": "string",
      "description": "Suggested file name, extension included"
    },
    "content_type": {
      "type": "string",
      "enum": [
        "application/pdf",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        "text/csv"
      ],
      "description": "MIME type of the file"
    },
    "size_bytes": {
      "type": "integer",
      "format": "int64",
      "description": "Size of the file in bytes"
    }
  },
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/reporting/interfaces/rest/resources/ReportDownloadLinkResource.java"
}
