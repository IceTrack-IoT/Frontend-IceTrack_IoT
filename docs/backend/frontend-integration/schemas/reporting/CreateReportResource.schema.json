{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreateReportResource",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 150,
      "description": "Display name of the report"
    },
    "type": {
      "type": "string",
      "enum": [
        "MAINTENANCE_COMPLIANCE",
        "EQUIPMENT_UPTIME",
        "TECHNICIAN_PERFORMANCE",
        "SERVICE_INTERVENTION",
        "TEMPERATURE_EXCURSION"
      ],
      "minLength": 1,
      "description": "Report type, by its enum name"
    },
    "format": {
      "type": "string",
      "enum": [
        "PDF",
        "XLSX",
        "CSV"
      ],
      "minLength": 1,
      "description": "Output format"
    },
    "filters": {
      "$ref": "ReportFiltersResource.schema.json",
      "description": "Scope and period of the report"
    }
  },
  "required": [
    "name",
    "type",
    "format",
    "filters"
  ],
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/reporting/interfaces/rest/resources/CreateReportResource.java"
}
