{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OwnerProfileResource",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "description": "Owner profile unique identifier"
    },
    "user_id": {
      "type": "integer",
      "format": "int64",
      "description": "Identifier of the platform account the owner belongs to"
    },
    "full_name": {
      "type": "string",
      "description": "Owner full name"
    },
    "email": {
      "type": "string",
      "description": "Owner email address"
    },
    "phone": {
      "type": "string",
      "description": "Owner phone number"
    },
    "address": {
      "type": "string",
      "description": "Owner complete street address"
    },
    "ruc": {
      "type": "integer",
      "format": "int64",
      "description": "11 digit taxpayer registration number (RUC)"
    },
    "street": { "type": "string", "description": "Street of the address" },
    "number": { "type": ["string", "null"], "description": "Street number or apartment; null when the address has none" },
    "city": { "type": "string", "description": "City of the address" },
    "postal_code": { "type": "string", "description": "Postal code of the address" },
    "country": { "type": "string", "description": "Country of the address" },
    "version": {
      "type": "integer",
      "format": "int64",
      "description": "Concurrency version; grows on every change. Send it back in If-Match to update the profile"
    }
  },
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/profiles/interfaces/rest/resources/OwnerProfileResource.java"
}
