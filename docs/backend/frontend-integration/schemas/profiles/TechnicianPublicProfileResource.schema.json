{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TechnicianPublicProfileResource",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer",
      "format": "int64",
      "description": "Technician profile unique identifier"
    },
    "full_name": {
      "type": "string",
      "description": "Technician full name"
    },
    "speciality": {
      "type": "string",
      "description": "Technician speciality"
    },
    "certification_number": {
      "type": "string",
      "description": "Technician certification number"
    },
    "completed_services": {
      "type": "integer",
      "format": "int32",
      "description": "Service requests the technician completed"
    },
    "average_rating": {
      "type": "number",
      "format": "double",
      "description": "Average of the technician's review scores, between 1 and 5; null until the first review"
    },
    "rating_available": {
      "type": "boolean",
      "description": "Whether average_rating is available, i.e. the technician has been reviewed"
    }
  },
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/profiles/interfaces/rest/resources/TechnicianPublicProfileResource.java"
}
