{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeEventResource",
  "type": "object",
  "properties": {
    "event_uid": {
      "type": "string",
      "format": "uuid",
      "description": "Identifier generated by the gateway"
    },
    "type": {
      "type": "string",
      "enum": [
        "THERMAL_EXCURSION_DETECTED",
        "THERMAL_EXCURSION_NORMALIZED",
        "MAINTENANCE_WINDOW_STARTED",
        "MAINTENANCE_WINDOW_ENDED"
      ],
      "description": "Kind of event"
    },
    "occurred_at": {
      "type": "string",
      "description": "Format: date-time (ISO 8601 UTC with Z, e.g. 2026-09-29T08:30:00Z) When the gateway observed the event"
    },
    "result": {
      "type": "string",
      "enum": [
        "ALERT_OPENED",
        "ALERT_ALREADY_ACTIVE",
        "ALERT_RESOLVED",
        "NO_ACTIVE_ALERT",
        "SUPPRESSED_BY_MAINTENANCE",
        "MAINTENANCE_WINDOW_OPENED",
        "MAINTENANCE_WINDOW_PROMOTED",
        "MAINTENANCE_ALREADY_ACTIVE",
        "MAINTENANCE_WINDOW_CLOSED",
        "NO_ACTIVE_MAINTENANCE"
      ],
      "description": "What processing the event did"
    },
    "alert_id": {
      "type": "integer",
      "format": "int64",
      "description": "Alert opened, already active or resolved; null otherwise"
    },
    "maintenance_window_id": {
      "type": "integer",
      "format": "int64",
      "description": "Maintenance window opened, kept, promoted or closed, or the one covering a suppressed detection; null otherwise"
    }
  },
  "x-source": "src/main/java/pe/edu/upc/ice/track/platform/monitoring/interfaces/rest/resources/EdgeEventResource.java"
}
